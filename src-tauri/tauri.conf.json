{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Android Sword",
  "version": "1.3.0",
  "identifier": "apktool.Creeeeeeeeeeper.AndroidSword",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "splash",
        "title": "",
        "url": "splash.html",
        "width": 420,
        "height": 180,
        "center": true,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "main",
        "title": "Android Sword",
        "width": 1200,
        "height": 860,
        "minWidth": 1200,
        "minHeight": 860,
        "resizable": true,
        "theme": "Dark",
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
